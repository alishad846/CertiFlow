NODE_ENV=production

NEXT_PUBLIC_API_URL=https://api.example.nip.io
API_PORT=4000
API_DOMAIN=api.example.nip.io
WEB_ORIGIN=https://your-vercel-project.vercel.app
AUTH_COOKIE_SAME_SITE=none

DATABASE_URL=postgresql://postgres:password@host:5432/certiflow
REDIS_URL=rediss://default:password@host:port

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

DEFAULT_COMPANY_CREDITS=100
SUPER_ADMIN_EMAIL=admin@certiflow.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

UPLOAD_DIR=/app/uploads
UPI_VPA=
UPI_PAYEE_NAME=CertiFlow
UPI_CURRENCY=INR
EMAIL_PROVIDER=nodemailer

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CertiFlow <no-reply@certiflow.com>"

RESEND_API_KEY=
RESEND_FROM=no-reply@certiflow.com

N8N_WEBHOOK_URL=
EMAIL_BATCH_DELAY_MS=30000
SOFFICE_PATH=soffice
