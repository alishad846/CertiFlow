{
  "name": "@certiflow/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node --max_old_space_size=4096 dist/index.js",
    "start:worker": "node --max_old_space_size=4096 dist/worker.js",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@certiflow/shared": "file:../../packages/shared",
    "@napi-rs/canvas": "0.1.100",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docxtemplater": "^3.49.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "playwright-core": "^1.60.0",
    "puppeteer": "^25.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
