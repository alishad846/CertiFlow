{
  "name": "@certiflow/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "reset:next-cache": "node -e \"const fs=require('node:fs'); const path=require('node:path'); const nextDir=path.join(process.cwd(),'.next'); try { fs.rmSync(nextDir,{recursive:true,force:true,maxRetries:5,retryDelay:100}); } catch (error) { if (fs.existsSync(nextDir)) { console.warn('Unable to fully clear .next cache, continuing.'); } } fs.mkdirSync(nextDir,{recursive:true});\"",
    "predev": "npm run reset:next-cache",
    "dev": "node --max_old_space_size=4096 ../../node_modules/next/dist/bin/next dev -p 3000",
    "prebuild": "npm run reset:next-cache",
    "build": "node --max_old_space_size=4096 ../../node_modules/next/dist/bin/next build",
    "prestart": "npm run reset:next-cache",
    "start": "node --max_old_space_size=4096 ../../node_modules/next/dist/bin/next start -p 3000"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@certiflow/shared": "file:../../packages/shared",
    "@number-flow/react": "^0.6.2",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/gradient": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/group": "4.0.1-alpha.0",
    "@visx/pattern": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.542.0",
    "motion": "^12.42.2",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
