NODE_ENV=development

NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
AUTH_COOKIE_SAME_SITE=strict

# PostgreSQL database running via Docker (mapped to port 5434 to avoid conflicts with local Postgres on 5432/5433)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/certiflow
# Redis cache running via Docker
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=eb2f5a201ffe1c819f3910434975527dc31aa74f8586dbd4cd5cc5b2c6f17f79
JWT_EXPIRES_IN=7d

DEFAULT_COMPANY_CREDITS=100
SUPER_ADMIN_EMAIL=alishad846@gmail.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# Uploads directory (use relative path for local development outside Docker)
UPLOAD_DIR=./apps/api/uploads

# Email & SMTP Configuration (required for Forgot Password and system emails)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="CertiFlow <no-reply@certiflow.local>"
SMTP_ALLOW_INVALID_CERTS=true

# Optional: Resend API Configuration
RESEND_API_KEY=
RESEND_FROM=no-reply@certiflow.local

# Optional: n8n Webhook Configuration
N8N_WEBHOOK_URL=
EMAIL_BATCH_DELAY_MS=30000

# LibreOffice path for document conversion (Windows default shown below; for macOS/Linux use 'soffice')
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
